# Copy to .env and fill in. The real .env is git-ignored.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ---- PostgreSQL (local: Docker container 'vihan-pg', see README) ----
DB_URL=jdbc:postgresql://localhost:5432/vihan
# The app's schema (tables live here, not in "public"); DB_USER should own it
DB_SCHEMA=vihanhspl
DB_USER=vihan_app
DB_PASSWORD=change_me

# ---- PostgreSQL (cloud: Neon; set in the Render dashboard, see deploy/README.md) ----
# DB_URL=jdbc:postgresql://<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require
# Cloud only: the website proxy's shared secret (DESIGN.md §16)
# PROXY_SECRET=

# ---- Security ----
JWT_SECRET=<64+ random chars>
# Aadhaar keys (DESIGN.md §10.7): Base64 of 32 random bytes each, e.g. PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Back them up safely: losing the ENC key makes stored Aadhaar numbers unreadable.
AADHAAR_ENC_KEY=<base64 32-byte key>
AADHAAR_HASH_KEY=<base64 32-byte key>
BOOTSTRAP_ADMIN_PASSWORD=<first-run only>
# Local only: password for the sample staff logins
DEV_SAMPLE_PASSWORD=<any>
# Local: Cloudflare test key 1x0000000000000000000000000000000AA (always passes)
TURNSTILE_SECRET_KEY=<from Cloudflare>
# Optional: only accept captchas solved on this host (production domain). Blank = no check.
TURNSTILE_HOSTNAME=
# Offline development only: skip the captcha check entirely. Never false in the cloud.
CAPTCHA_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Confirmation email (DESIGN.md §19.8) ----
# log = only written to the log (default; the local profile shows the form anyway).
# brevo = sent through Brevo's HTTP API (free ~300/day); then BREVO_API_KEY and MAIL_FROM are required.
EMAIL_PROVIDER=log
# EMAIL_FORM_ENABLED=true
# BREVO_API_KEY=
# MAIL_FROM=<sender verified in Brevo>
SITE_URL=http://localhost:5173
# Marks emails and WhatsApp texts "test project, not a real hospital". false only for the real hospital.
EMAIL_TEST_BANNER=true

# ---- Files ----
# Uploaded images: database (default) or disk (then UPLOAD_DIR is used)
FILE_STORAGE=database
UPLOAD_DIR=./uploads
PUBLIC_FILE_BASE_URL=/files
